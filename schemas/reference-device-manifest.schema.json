{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://vectorvision.example/schemas/reference-device-manifest.schema.json",
  "title": "Vector Vision Reference Device Manifest",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version", "manifest_id", "manifest_version", "classification", "validation_status",
    "selection_status", "manufacturer", "product_family", "full_model_number", "firmware_version",
    "driver_or_sdk", "operating_system", "protocols", "licensing_status", "lifecycle_status",
    "source_datasheets", "required_evidence_gates", "limitations"
  ],
  "properties": {
    "schema_version": { "const": "1.0.0" },
    "manifest_id": { "type": "string", "pattern": "^[a-z0-9][a-z0-9-]{2,63}$" },
    "manifest_version": { "type": "string", "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$" },
    "classification": { "enum": ["REFERENCE_HARDWARE", "PROTOCOL_COMPATIBLE_HARDWARE", "CERTIFIED_PLATFORM_COMPATIBLE_HARDWARE"] },
    "validation_status": { "enum": ["TARGET", "DOCUMENTED", "BENCH_VERIFIED", "VALIDATED", "RESTRICTED", "REVOKED"] },
    "selection_status": { "enum": ["PENDING_ENGINEERING_SELECTION", "SELECTED"] },
    "manufacturer": { "type": "string", "minLength": 1 },
    "product_family": { "type": "string", "minLength": 1 },
    "full_model_number": { "type": "string", "minLength": 1 },
    "firmware_version": { "type": "string", "minLength": 1 },
    "driver_or_sdk": {
      "type": "object", "additionalProperties": false, "required": ["name", "version"],
      "properties": { "name": { "type": "string", "minLength": 1 }, "version": { "type": "string", "minLength": 1 } }
    },
    "operating_system": { "type": "string", "minLength": 1 },
    "protocols": { "type": "array", "minItems": 1, "uniqueItems": true, "items": { "type": "string", "minLength": 1 } },
    "licensing_status": { "type": "string", "minLength": 1 },
    "lifecycle_status": { "type": "string", "minLength": 1 },
    "source_datasheets": {
      "type": "array", "minItems": 1,
      "items": {
        "type": "object", "additionalProperties": false, "required": ["title", "url", "retrieved_date"],
        "properties": {
          "title": { "type": "string", "minLength": 1 },
          "url": { "type": "string", "format": "uri" },
          "retrieved_date": { "type": "string", "format": "date" }
        }
      }
    },
    "required_evidence_gates": {
      "type": "object", "additionalProperties": false,
      "required": ["camera_discovery", "acquisition", "triggering", "parameter_control", "plc_exchange", "reconnection_recovery", "performance", "timestamp_correlation", "security", "soak_72_hour"],
      "properties": {
        "camera_discovery": { "$ref": "#/$defs/gateStatus" }, "acquisition": { "$ref": "#/$defs/gateStatus" },
        "triggering": { "$ref": "#/$defs/gateStatus" }, "parameter_control": { "$ref": "#/$defs/gateStatus" },
        "plc_exchange": { "$ref": "#/$defs/gateStatus" }, "reconnection_recovery": { "$ref": "#/$defs/gateStatus" },
        "performance": { "$ref": "#/$defs/gateStatus" }, "timestamp_correlation": { "$ref": "#/$defs/gateStatus" },
        "security": { "$ref": "#/$defs/gateStatus" }, "soak_72_hour": { "$ref": "#/$defs/gateStatus" }
      }
    },
    "limitations": { "type": "array", "minItems": 1, "items": { "type": "string", "minLength": 1 } }
  },
  "$defs": { "gateStatus": { "enum": ["NOT_APPLICABLE", "NOT_RUN", "BLOCKED", "FAIL", "PARTIAL", "PASS"] } }
}
